# Required in production
JWT_SECRET=
MONGODB_URI=
GROQ_API_KEY=

# Public URL of the app: one of these is required in production
APP_BASE_URL=
FRONTEND_URL=

# Number of proxies in front of the server (see SECURITY.md)
TRUST_PROXY_HOPS=

# First admin on an empty database
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional
NODE_ENV=
PORT=8000
ACCESS_TOKEN_MINUTES=60
LOG_LEVEL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Frontend build time only. Leave unset when the API is served from the same origin.
VITE_API_BASE=